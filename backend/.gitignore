# compiled output
/dist
/node_modules
.env

# Everything users upload, at any depth — avatars/, spaces/, floors/ are
# created at runtime when Cloudinary is not configured. Keep the directory
# itself so the path exists on a fresh clone.
/uploadedFiles/**
!/uploadedFiles/.gitkeep

/generatedFiles/*.png
/generatedFiles/*.jpg
/generatedFiles/*.jpeg
/generatedFiles/*.pdf

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

