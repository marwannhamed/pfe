# Server Configuration
APP_PORT=6001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
APP_PUBLIC_URL=http://localhost:6001

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lease_management
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXP_IN=1h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXP_IN=7d

# Email — pick ONE provider (recommended: Brevo for real delivery)
#
# MAIL_PROVIDER=auto|brevo|smtp
#   auto  — Brevo if API key set; in dev with Mailtrap host, SMTP first (emails in Mailtrap inbox)
#   brevo — always Brevo API (check Brevo → Transactional → Logs)
#   smtp  — always SMTP/Mailtrap (check mailtrap.io inbox)
MAIL_PROVIDER=auto
#
# Option A — Brevo (production / real inboxes)
# BREVO_API_KEY=xkeysib-your-key-here
# MAIL_FROM=your-verified-sender@gmail.com   # MUST match a sender verified in Brevo dashboard
# MAIL_FROM_NAME=LeaseManager
#
# Option B — SMTP (Mailtrap for dev, Gmail for prod)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@yourcompany.com
MAIL_FROM_NAME=LeaseManager Support
#
# If neither BREVO_API_KEY nor MAIL_* is set, emails are logged to the backend console only.

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Rate Limiting (disabled in development by default — enable with RATE_LIMIT_ENABLED=true)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret

# Monitoring
ENABLE_METRICS=true
HEALTH_CHECK_ENDPOINT=/health

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# ── Software integrations (optional; never store these in the DB — use SiteIntegration.config for non-secrets only)
# Access control
# SALTO_API_BASE_URL=https://api.saltosystems.com
# SALTO_API_CLIENT_ID=
# SALTO_API_CLIENT_SECRET=
# KISI_API_BASE_URL=https://api.kisi.io
# KISI_API_KEY=
# BRIVO_API_BASE_URL=
# BRIVO_CLIENT_ID=
# BRIVO_CLIENT_SECRET=
# Visitors
# ENVOY_API_BASE_URL=https://api.envoy.com
# ENVOY_API_TOKEN=
# GREETLY_API_KEY=
# Video
# VERKADA_API_BASE_URL=https://api.verkada.com
# VERKADA_API_KEY=
# MILESTONE_API_BASE_URL=
# MILESTONE_USERNAME=
# MILESTONE_PASSWORD=
# Building automation (REST gateways to field networks — software side only in this repo)
# BACNET_GATEWAY_URL=
# BACNET_GATEWAY_TOKEN=
# MODBUS_GATEWAY_URL=
# MODBUS_GATEWAY_TOKEN=
# Utilities / occupancy
# SMART_METER_API_BASE_URL=
# SMART_METER_API_KEY=
# OCCUPANCY_WEBHOOK_SECRET=
# Network
# MERAKI_API_BASE_URL=https://api.meraki.com/api/v1
# MERAKI_API_KEY=

# AI assistant (OpenAI-compatible API: OpenAI, Groq free tier, OpenRouter, etc.)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Optional — Groq (free): OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_MODEL=openai/gpt-oss-120b
# Groq retires models fairly often; if the AI routes start answering 502 with
# "model_not_found", list what the key can still reach with:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $OPENAI_API_KEY"
# Optional — OpenAI only: leave OPENAI_BASE_URL unset (defaults to api.openai.com)
# OPENAI_BASE_URL=

# Coworker.com / LiquidSpace marketplace listings (optional)
# COWORKER_API_BASE_URL=
# COWORKER_API_TOKEN=
# LIQUIDSPACE_API_BASE_URL=
# LIQUIDSPACE_API_TOKEN=
# Webhook HMAC: hex(HMAC_SHA256(secret, inquiryId|start|end|spaceId|listingId)) — header X-Marketplace-Signature
# COWORKER_WEBHOOK_SECRET=
# LIQUIDSPACE_WEBHOOK_SECRET=
# MARKETPLACE_WEBHOOK_SECRET=
# MARKETPLACE_WEBHOOK_VERIFY=false

# Brevo (Sendinblue) — transactional templates managed in Brevo dashboard; IDs only in env
# BREVO_API_KEY=xkeysib-...
# Optional survey link for Day 30 template merge tag SURVEY_URL
# BREVO_SURVEY_URL=https://your-survey.example.com/tenant-feedback
# BREVO_TEMPLATE_ONBOARDING_DAY0=
# BREVO_TEMPLATE_ONBOARDING_DAY1=
# BREVO_TEMPLATE_ONBOARDING_DAY3=
# BREVO_TEMPLATE_ONBOARDING_DAY7=
# BREVO_TEMPLATE_ONBOARDING_DAY30=
# BREVO_TEMPLATE_INVOICE_GENERATED=
# BREVO_TEMPLATE_OVERDUE_DAY1=
# BREVO_TEMPLATE_OVERDUE_DAY7=
# BREVO_TEMPLATE_OVERDUE_DAY14=
# BREVO_TEMPLATE_LEASE_EXPIRING_60=
# BREVO_TEMPLATE_LEASE_EXPIRING_30=
# BREVO_TEMPLATE_LEASE_EXPIRING_7=
# BREVO_TEMPLATE_MAINTENANCE_STATUS=

# Crisp live chat (frontend: VITE_CRISP_WEBSITE_ID; backend webhook for tagged conversations)
# VITE_CRISP_WEBSITE_ID=your-website-uuid   # in frontend/.env
# CRISP_WEBHOOK_SECRET=                       # HMAC key from Crisp webhook plugin (request body + timestamp)
# CRISP_WEBHOOK_VERIFY=false                 # dev only — skip signature verification
# CRISP_WEBHOOK_FALLBACK_TENANT_ID=         # optional UUID when visitor email is not a known user

# Google Business Profile (OAuth + Business Information API; per-site tokens in DB — encrypt in production)
# GOOGLE_GMB_CLIENT_ID=
# GOOGLE_GMB_CLIENT_SECRET=
# Redirect must match Google Cloud Console OAuth client (backend callback URL)
# GOOGLE_GMB_REDIRECT_URI=http://localhost:6001/integrations/google-business/oauth/callback
# Optional: dedicated HMAC secret for OAuth state (defaults to JWT_SECRET)
# GOOGLE_GMB_OAUTH_STATE_SECRET=
# Public API base used when GOOGLE_GMB_REDIRECT_URI is omitted
# APP_PUBLIC_URL=http://localhost:6001
# Daily sync runs at 03:00 server time; set false to disable
# GMB_SYNC_ENABLED=true
# Photo push creates new media each run — enable only if you accept duplicates or rotate externally
# GMB_SYNC_PHOTOS=false

# Typeform — tenant onboarding applications (webhook + pre-filled links)
# TYPEFORM_FORM_ID=your_form_id
# TYPEFORM_BASE_URL=https://form.typeform.com/to
# TYPEFORM_WEBHOOK_SECRET=
# Webhook URL in Typeform: https://<API_HOST>/webhooks/typeform/application
# Add hidden fields in the form: inquiry_id, site_id, space_id (names must match the generated URL).
