<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>New Maintenance Ticket</title>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { background: {{#if isUrgent}}#dc2626{{else}}#2563eb{{/if}}; color: white; padding: 20px; text-align: center; }
        .content { padding: 20px; background: #f9fafb; }
        .ticket-details { background: white; padding: 15px; border-radius: 5px; margin: 10px 0; }
        .priority-high { color: #dc2626; font-weight: bold; }
        .priority-normal { color: #2563eb; font-weight: bold; }
        .footer { text-align: center; padding: 20px; color: #666; font-size: 12px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🔧 New Maintenance Ticket</h1>
        </div>
        <div class="content">
            <p>Dear {{assigneeName}},</p>
            <p>A new maintenance ticket has been created and assigned to you. Please review and take appropriate action:</p>
            
            <div class="ticket-details">
                <h3>Ticket Information</h3>
                <p><strong>Ticket Number:</strong> {{ticketNumber}}</p>
                <p><strong>Title:</strong> {{title}}</p>
                <p><strong>Priority:</strong> <span class="priority-{{#if (eq priority 'URGENT')}}high{{#else if (eq priority 'EMERGENCY')}}high{{else}}normal{{/if}}">{{priority}}</span></p>
                <p><strong>Category:</strong> {{category}}</p>
                <p><strong>Space:</strong> {{spaceName}}</p>
                {{#if description}}
                <p><strong>Description:</strong> {{description}}</p>
                {{/if}}
            </div>
            
            {{#if isUrgent}}
                <p><strong>URGENT:</strong> This ticket has been marked as high priority and requires immediate attention.</p>
            {{else}}
                <p>Please assess this maintenance request and schedule repairs as needed.</p>
            {{/if}}
            
            <p>Log in to your dashboard to view full details and update the ticket status.</p>
        </div>
        <div class="footer">
            <p>This is an automated message. Please do not reply to this email.</p>
        </div>
    </div>
</body>
</html>
