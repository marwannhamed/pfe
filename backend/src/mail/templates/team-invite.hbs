<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <style>
    body { font-family: Arial, sans-serif; background: #f8fafc; margin: 0; padding: 24px; color: #0f172a; }
    .card { max-width: 560px; margin: 0 auto; background: #fff; border-radius: 12px; padding: 32px; box-shadow: 0 4px 24px rgba(15,23,42,0.08); }
    .btn { display: inline-block; background: #2563eb; color: #fff !important; text-decoration: none; padding: 12px 24px; border-radius: 8px; font-weight: 700; margin-top: 16px; }
    .muted { color: #64748b; font-size: 13px; line-height: 1.6; }
  </style>
</head>
<body>
  <div class="card">
    <h2 style="margin-top:0;">You're invited to LeaseManager</h2>
    <p>Hi {{firstName}},</p>
    <p><strong>{{inviterName}}</strong> invited you to join <strong>{{organizationName}}</strong> as <strong>{{roleLabel}}</strong>.</p>
    <p>Click below to set your password and access your account:</p>
    <p><a class="btn" href="{{inviteUrl}}">Accept invitation</a></p>
    <p class="muted">This link expires in {{expiresIn}}. If you did not expect this email, you can ignore it.</p>
  </div>
</body>
</html>
