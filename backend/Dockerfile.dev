# NestJS 11 requires Node >= 20; the image was still on 18, which is also
# what CI runs, so keep the two in step.
FROM node:20

WORKDIR /app

# Dependencies first, so a source edit does not reinstall them
COPY package*.json ./
RUN npm install --legacy-peer-deps

# The Prisma client is generated against the schema, so it needs the schema
# before the rest of the source. Generating here bakes the Linux engine into
# the image layer rather than relying on whatever the host produced.
COPY prisma ./prisma/
RUN npx prisma generate

COPY . .

EXPOSE 6001

# migrate deploy refuses a database that already has tables but no migration
# history (P3005) — which is what `prisma db push` leaves behind. Fall back to
# db push so a developer's existing database still starts, then seed only when
# the database is empty.
CMD ["/bin/sh", "-c", "npx prisma migrate deploy || npx prisma db push --skip-generate; node scripts/seed-if-empty.mjs; npm run start:dev"]
