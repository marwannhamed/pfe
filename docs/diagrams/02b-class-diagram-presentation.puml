@startuml 02b-class-diagram-presentation
!include _theme.puml

' Reduced version of the class diagram, built for projection.
' The full diagram (02-class-diagram.puml) stays the written report's reference:
' 17 classes across five packages, unreadable beyond two metres.
' Here: the ten classes that carry the argument, in landscape, with at most
' three attributes each.

title Class diagram — business core

left to right direction
skinparam linetype ortho

class Tenant {
  +organization_type : CLIENT | RENTER
  +status
  --
  +isLandlord()
}

class User {
  +tenant_id
  +role : 9 values
  +email
}

class Building {
  +tenant_id <<owner>>
  +name
}

class Floor {
  +floor_number
}

class Space {
  +type : 7 values
  +status
  +monthly_rate
  +is_published
}

class Booking {
  +tenant_id <<renter>>
  +status : 12 states
  +total_amount
}

class LeaseContract {
  +contract_number
  +monthly_rent
  +status
}

class Invoice {
  +total_amount
  +due_date
  +status
}

class Payment {
  +method : cash | transfer | cheque
  +recorded_by_id
}

class MaintenanceTicket {
  +tenant_id <<renter>>
  +category
  +priority
  +assigned_to
}

Tenant "1" *-- "0..*" User
Tenant "1" *-- "0..*" Building
Building "1" *-- "1..*" Floor
Floor "1" *-- "1..*" Space
Space "1" o-- "0..*" Booking
Tenant "1" o-- "0..*" Booking
Tenant "1" o-- "0..*" LeaseContract
LeaseContract "1" o-- "0..*" Invoice
Invoice "1" o-- "0..*" Payment
Space "1" o-- "0..*" MaintenanceTicket

note bottom of Booking
  <b>tenant_id</b> is the <b>renter</b>.
  The landlord reaches the same row through
  Space → Floor → Building.tenant_id.
end note

@enduml
