@startuml 05-sequence-onboarding
!include _theme.puml

title Sequence diagram — onboarding a renter company

autonumber "<b>[00]"

actor "Prospect" as P
actor "Manager" as MGR
participant "Typeform" as TF
box "LeaseManager" #FAFCFC
  participant "FormService" as FORM
  participant "TenantApplication\nService" as TAS
  participant "AuthService" as AUTH
end box
database "PostgreSQL" as DB
participant "Brevo" as BV

== Creating the application link ==
MGR -> FORM : POST /forms/typeform/inquiry\n{ space_id }
activate FORM
FORM -> DB : TenantApplication\n(AWAITING_SUBMISSION)
FORM --> MGR : link carrying inquiry_id + space_id
deactivate FORM

MGR -> P : sends the link

== Submitting the file ==
P -> TF : completes the form,\nuploads licence and registration
activate TF
TF -> FORM : POST /webhooks/typeform  <<signed>>
deactivate TF
activate FORM
FORM -> DB : Tenant (PENDING)\n+ application_profile\n+ application_documents
FORM -> DB : TenantApplication -> SUBMITTED
FORM -> BV : notify the reviewers
BV --> MGR : "new tenant application"
deactivate FORM

== Review ==
MGR -> TAS : POST /tenant-applications/{id}/approve
activate TAS
TAS -> TAS : assertReviewer(user, landlord_tenant_id)

alt applicant organisation missing or already handled
  TAS --> MGR : 400 Bad Request
else application admissible
  group Single transaction
    TAS -> DB : Tenant : PENDING -> TRIAL
    TAS -> DB : Application -> APPROVED
    TAS -> DB : User (TENANT_ADMIN,\nrandom password)
  end
  TAS -> AUTH : requestPasswordReset(email)
  activate AUTH
  AUTH -> BV : password reset email
  deactivate AUTH
  BV --> P : "set your password"
  TAS --> MGR : { approved: true }
end
deactivate TAS

note over P, DB
  The generated password is never displayed or transmitted:
  the new administrator sets their own through the emailed link.
end note

legend bottom
  The only path by which a renter company enters the system. It starts outside
  the application.
endlegend

@enduml
