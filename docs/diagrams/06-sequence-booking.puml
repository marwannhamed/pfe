@startuml 06-sequence-booking
!include _theme.puml

title Sequence diagram — from enquiry to signed lease

autonumber "<b>[00]"

actor "Visitor" as G
actor "Manager" as MGR
actor "Receptionist" as REC
actor "Tenant admin" as TA
box "LeaseManager" #FAFCFC
  participant "BookingApplication\nService" as BAS
  participant "BookingService" as BS
  participant "LeaseContract\nService" as LCS
  participant "BillingService" as BILL
end box
database "PostgreSQL" as DB

== Public enquiry ==
G -> BAS : POST /booking-applications/guest
activate BAS
BAS -> DB : BookingApplication (PENDING)
deactivate BAS

MGR -> BAS : PATCH /booking-applications/{id}/accept
activate BAS
BAS -> DB : Booking\n(PENDING_PHONE_CONFIRMATION)
deactivate BAS

== Qualification in person ==
REC -> BS : PATCH /bookings/{id}/phone-confirmed
activate BS
BS -> DB : status -> AWAITING_PHYSICAL_VISIT
deactivate BS

REC -> BS : PATCH /bookings/{id}/mark-documents-pending
activate BS
BS -> DB : status -> DOCUMENTS_PENDING_UPLOAD
deactivate BS

TA -> BS : POST /bookings/{id}/documents
activate BS
alt more than five documents
  BS --> TA : 400 Bad Request
else
  BS -> DB : BookingDocument
end
deactivate BS

== Contract ==
MGR -> BS : PATCH /bookings/{id}/approve
activate BS
BS -> DB : status -> CONFIRMED
deactivate BS

MGR -> LCS : PATCH /bookings/{id}/generate-contract
activate LCS
LCS -> DB : LeaseContract (DRAFT)
LCS -> DB : Space.status -> OCCUPIED
deactivate LCS

TA -> LCS : PATCH /lease-contracts/{id}/sign
activate LCS
LCS -> DB : contract -> ACTIVE
LCS -> BILL : first instalment
activate BILL
BILL -> DB : Invoice + InvoiceLine
deactivate BILL
deactivate LCS

note over REC, DB
  The middle band — the call, then the visit — is what
  most platforms omit and this market requires.
end note

legend bottom
  Twenty routes serve /bookings because the process is conducted face to face.
endlegend

@enduml
