' Generated by tools/gen_usecase.py from one use case model; edit the generator, not this file.
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 8
skinparam ranksep 200
skinparam linetype polyline
title Detailed use case diagram — every use case of LeaseManager

actor "Signed-in User" as SU <<abstract>>
actor "Visitor" as VIS
actor "Tenant Administrator" as TA
actor "Tenant Employee" as TE
actor "Company Administrator" as CA
actor "Property Manager" as PM
actor "Receptionist" as RC
actor "Finance Officer" as FI
actor "Maintenance Technician" as MT
actor "Platform Owner" as PO

rectangle "LeaseManager" {
  package "Account and notifications" {
    usecase "Authenticate" as ACC_auth
    usecase "Log out" as ACC_logout
    usecase "Consult own dashboard" as ACC_dash
    usecase "Search the platform" as ACC_search
    usecase "Manage own profile" as ACC_profile
    usecase "Manage active sessions" as ACC_sessions
    usecase "Consult notifications" as ACC_notif
    usecase "Reset a forgotten\npassword" as ACC_reset
    usecase "Change password" as ACC_pwd
    usecase "Upload a profile photo" as ACC_photo
    usecase "Revoke a session" as ACC_revoke
    usecase "Consult login activity" as ACC_activity
    usecase "Set notification\npreferences" as ACC_prefs
  }
  package "Public catalogue" {
    usecase "Browse the public map" as PUB_map
    usecase "Search with the\nAI space finder" as PUB_ai
    usecase "Consult pricing\nand offers" as PUB_pricing
    usecase "Submit a booking\napplication" as PUB_apply
    usecase "Submit a company\napplication (Typeform)" as PUB_company
    usecase "Register a\nrenter company" as PUB_register
    usecase "Consult space details" as PUB_details
    usecase "Take the virtual tour" as PUB_tour
    usecase "Choose add-on services" as PUB_addons
  }
  package "Tenant workspace" {
    usecase "Browse the floor map" as TEN_floor
    usecase "Book a space" as TEN_book
    usecase "Follow own bookings" as TEN_mybookings
    usecase "Check in and\ncheck out" as TEN_checkin
    usecase "Report a maintenance\nproblem" as TEN_report
    usecase "Follow own\nmaintenance tickets" as TEN_tickets
    usecase "Ask the AI\ntenant assistant" as TEN_assistant
    usecase "Chat with support\n(Crisp)" as TEN_support
    usecase "Order add-on services" as TEN_order
    usecase "Cancel a booking" as TEN_cancel
    usecase "Get an AI triage\nsuggestion" as TEN_triage
    usecase "Cancel a ticket" as TEN_cancelticket
    usecase "Check availability\nand capacity" as TEN_check
  }
  package "Tenant administration" {
    usecase "Manage team members" as TAD_team
    usecase "Consult the company's\nbookings" as TAD_bookings
    usecase "Consult lease contracts" as TAD_contracts
    usecase "Sign a lease contract" as TAD_sign
    usecase "Consult invoices" as TAD_invoices
    usecase "Report a payment" as TAD_pay
    usecase "Export the\ncompany's data" as TAD_export
    usecase "Consult BI reports\n(Power BI, Tableau)" as TAD_reports
    usecase "Configure the\nBI report embeds" as TAD_embeds
    usecase "Invite a team member" as TAD_invite
    usecase "Remove a team member" as TAD_remove
    usecase "Consult the financial\nsummary" as TAD_summary
    usecase "Attach a cheque scan" as TAD_cheque
  }
  package "Property portfolio" {
    usecase "Manage buildings" as POR_buildings
    usecase "Manage floors" as POR_floors
    usecase "Manage spaces" as POR_spaces
    usecase "Manage add-on services" as POR_addons
    usecase "Manage promotion codes" as POR_promo
    usecase "Upload a floor plan" as POR_plan
    usecase "Publish a space on\nthe public map" as POR_publish
    usecase "Position a space\non the floor map" as POR_position
    usecase "Upload space photos" as POR_photos
  }
  package "Applications and bookings" {
    usecase "Review booking\napplications" as APP_review
    usecase "Send a company\napplication link" as APP_link
    usecase "Review company\napplications" as APP_companies
    usecase "Process booking\nrequests" as APP_requests
    usecase "Consult the\nreception queues" as APP_queues
    usecase "Conduct the\nin-person intake" as APP_intake
    usecase "Finalize a\nlease booking" as APP_finalize
    usecase "Accept the application" as APP_accept
    usecase "Refuse the application" as APP_refuse
    usecase "Approve the company\napplication" as APP_approve
    usecase "Reject the company\napplication" as APP_reject
    usecase "Approve a booking" as APP_bkapprove
    usecase "Reject a booking" as APP_bkreject
    usecase "Confirm the phone call" as APP_call
    usecase "Mark the applicant\nunreachable" as APP_unreach
    usecase "Mark the site\nvisit complete" as APP_visit
    usecase "Upload supporting\ndocuments" as APP_docs
    usecase "Check the signed\nlease document" as APP_checkdoc
  }
  package "Leases and billing" {
    usecase "Delete an invoice" as BIL_delete
    usecase "Manage lease\ncontracts" as LEA_manage
    usecase "Manage invoices" as BIL_invoices
    usecase "Manage payments" as BIL_payments
    usecase "Follow contract\nrenewals" as LEA_renewals
    usecase "Create a contract" as LEA_create
    usecase "Renew a contract" as LEA_renew
    usecase "Terminate a contract" as LEA_terminate
    usecase "Ask the AI\nlease assistant" as LEA_assistant
    usecase "Create an invoice" as BIL_create
    usecase "Add invoice lines" as BIL_lines
    usecase "Send an invoice" as BIL_send
    usecase "Cancel an invoice" as BIL_cancel
    usecase "Record a payment" as BIL_record
    usecase "Confirm a reported\npayment" as BIL_confirm
    usecase "Refund a payment" as BIL_refund
  }
  package "Maintenance" {
    usecase "Supervise maintenance" as MAI_supervise
    usecase "Consult the\nrisk scoring" as MAI_risk
    usecase "Handle maintenance\ntickets" as MAI_handle
    usecase "Assign a technician" as MAI_assign
    usecase "Accept an\nunassigned ticket" as MAI_accept
    usecase "Start the work" as MAI_start
    usecase "Resolve a ticket" as MAI_resolve
    usecase "Close a ticket" as MAI_close
  }
  package "Analytics and reporting" {
    usecase "Consult analytics" as ANA_analytics
    usecase "Export data\n(CSV, Excel)" as ANA_export
    usecase "Consult BI reports\n(Power BI, Tableau)" as ANA_reports
    usecase "Configure the\nBI report embeds" as ANA_embeds
    usecase "Consult the\noccupancy heatmap" as ANA_heat
    usecase "Consult the\nrevenue forecast" as ANA_forecast
  }
  package "Company and staff" {
    usecase "Edit the\ncompany profile" as ORG_edit
    usecase "Delete a user account" as ORG_delete
    usecase "Consult the\ncompany profile" as ORG_view
    usecase "Manage staff accounts" as ORG_staff
    usecase "Invite a staff member" as ORG_invite
  }
  package "Platform administration" {
    usecase "Administer organisations" as PLA_orgs
    usecase "Administer all\nuser accounts" as PLA_users
    usecase "Oversee the operations\nof every organisation" as PLA_oversee
    usecase "Consult audit logs" as PLA_audit
    usecase "Supervise e-mail\ndelivery" as PLA_mail
    usecase "Monitor the\nsystem health" as PLA_health
    usecase "Send a notification" as PLA_notify
    usecase "Provision a\nproperty company" as PLA_provision
    usecase "Suspend or reactivate\nan organisation" as PLA_suspend
  }
}

