@startuml 02-class-diagram
!include _theme.puml

title Class diagram — business domain

skinparam linetype ortho

package "Organisations and identity" {
  class Tenant {
    +id : UUID
    +name : String
    +slug : String
    +status : TenantStatus
    +organization_type : CLIENT | RENTER
    +subscription_plan : String
    +application_profile : Json
    --
    +isLandlord() : Boolean
  }

  class User {
    +id : UUID
    +tenant_id : UUID
    +tenant_company_id : UUID
    +role : UserRole
    +email : String
    +password : String <<bcrypt>>
    +status : UserStatus
  }

  class UserSession {
    +id : UUID
    +refresh_token : String
    +last_used_at : DateTime
  }
}

package "Property portfolio" {
  class Building {
    +id : UUID
    +tenant_id : UUID <<owner>>
    +name : String
    +address : String
    +total_area_sqm : Float
  }

  class Floor {
    +id : UUID
    +floor_number : Int
    +area_sqm : Float
  }

  class Space {
    +id : UUID
    +name : String
    +type : SpaceType
    +status : SpaceStatus
    +capacity : Int
    +area_sqm : Float
    +monthly_rate : Float
    +is_published : Boolean
    +map_lat : Float
    +map_lng : Float
    --
    +isBookable() : Boolean
  }

  class SpaceFeature {
    +name : String
  }
}

package "Booking and contracting" {
  class BookingApplication {
    +id : UUID
    +applicant_type : String
    +headcount : Int
    +duration_months : Int
    +status : ApplicationStatus
  }

  class Booking {
    +id : UUID
    +tenant_id : UUID <<renter>>
    +booking_number : String
    +start_time : DateTime
    +end_time : DateTime
    +status : BookingStatus
    +total_amount : Float
  }

  class BookingDocument {
    +file_url : String
    +document_type : String
  }

  class LeaseContract {
    +id : UUID
    +contract_number : String
    +start_date : Date
    +end_date : Date
    +monthly_rent : Float
    +status : ContractStatus
  }
}

package "Billing" {
  class Invoice {
    +id : UUID
    +invoice_number : String
    +total_amount : Float
    +tax_rate : Float
    +due_date : Date
    +status : InvoiceStatus
  }

  class InvoiceLine {
    +description : String
    +quantity : Float
    +unit_price : Float
  }

  class Payment {
    +id : UUID
    +payment_number : String
    +amount : Float
    +method : CASH | BANK_TRANSFER | CHECK
    +status : PaymentStatus
    +recorded_by_id : UUID
  }

  class PromotionCode {
    +code : String
    +discount : Float
    +type : DiscountType
  }
}

package "Operations" {
  class MaintenanceTicket {
    +id : UUID
    +tenant_id : UUID <<renter>>
    +ticket_number : String
    +category : TicketCategory
    +priority : TicketPriority
    +status : TicketStatus
    +assigned_to : UUID
    +cost : Float
  }

  class Notification {
    +type : NotificationType
    +title : String
    +is_read : Boolean
  }

  class AuditLog {
    +action : AuditAction
    +severity : AuditSeverity
    +ip_address : String
  }
}

' ── Relations ────────────────────────────────────────────────────────────────
Tenant "1" *-- "0..*" User : employs
User "1" *-- "0..*" UserSession : opens
Tenant "1" *-- "0..*" Building : owns
Building "1" *-- "1..*" Floor : contains
Floor "1" *-- "1..*" Space : contains
Space "1" *-- "0..*" SpaceFeature : described by

Space "1" o-- "0..*" BookingApplication : enquired on
BookingApplication "0..1" -- "0..1" Booking : leads to
Space "1" o-- "0..*" Booking : booked as
Tenant "1" o-- "0..*" Booking : held by
User "1" o-- "0..*" Booking : made by
Booking "1" *-- "0..5" BookingDocument : evidenced by

Tenant "1" o-- "0..*" LeaseContract : signs
LeaseContract "1" o-- "0..*" Invoice : bills
Invoice "1" *-- "1..*" InvoiceLine : itemised by
Invoice "1" o-- "0..*" Payment : settled by
Booking "0..*" -- "0..1" Invoice : billed on
PromotionCode "0..1" -- "0..*" Invoice : discount

Space "1" o-- "0..*" MaintenanceTicket : raises
User "1" o-- "0..*" MaintenanceTicket : assigned to
Tenant "1" o-- "0..*" Notification : receives
Tenant "1" o-- "0..*" AuditLog : tracked by

note bottom of Booking
  <b>tenant_id</b> is the <b>renter</b>.
  The property company reaches the same row
  through Space → Floor → Building.tenant_id.
  Confusing the two is the origin of every
  cross-tenant leak that was fixed.
end note

@enduml
