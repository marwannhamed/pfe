@startuml 03-package-architecture
!include _theme.puml

title Layered architecture — from browser to database

skinparam linetype ortho

package "Client" as CL {
  component "React 19 · Vite" as UI
  component "TanStack Query" as TQ
  component "Zustand\n(per-tab session)" as ZS
  component "Socket.IO client" as WSC
}

package "Delivery" as DIF {
  component "nginx\nSPA + API proxy" as NGX
}

package "API — NestJS 11" as API {

  package "Security chain" as SEC {
    component "JwtAuthGuard" as G1
    component "RolesGuard" as G2
    component "ValidationPipe" as G3
    component "ThrottlerGuard" as G4
  }

  package "Presentation" as PRES {
    component "30 controllers\n218 routes" as CTRL
    component "NotificationsGateway" as GATE
  }

  package "Business" as BIZ {
    component "Services *ForUser" as SVC
    component "AccessPolicyService" as POL
    component "AI services\ntriage · extraction · search" as AI
  }

  package "Cross-cutting" as CROSS {
    component "Interceptors\nresponse · performance" as INT
    component "Scheduled jobs\n@Cron" as CRON
    component "AuditService" as AUD
  }
}

package "Persistence" as PERS {
  component "Prisma ORM" as PRISMA
  database "PostgreSQL 13\n25 tables · 35 migrations" as DB
}

package "External services" as EXTP {
  component "Groq" as GROQ
  component "Brevo" as BREVO
  component "Cloudinary" as CLOUD
  component "Typeform" as TYPE
}

UI --> TQ
UI --> ZS
UI --> NGX : HTTP
WSC --> NGX : WebSocket
NGX --> G1
G1 --> G2
G2 --> G3
G3 --> CTRL
G4 --> CTRL
NGX --> GATE
CTRL --> SVC
GATE --> SVC
SVC --> POL
SVC --> AI
POL --> PRISMA
AI --> PRISMA
SVC --> AUD
CRON --> SVC
CTRL --> INT
PRISMA --> DB
AI ..> GROQ
SVC ..> BREVO
SVC ..> CLOUD
TYPE ..> CTRL

note right of POL
  The single authority on isolation.
  isCrossTenantReader() is true for
  the platform owner alone; everything
  else turns the caller into a Prisma
  filter.
end note

legend bottom
  Each layer narrows what the next one can reach.
  No layer below the security chain trusts anything coming from above it.
endlegend

@enduml
