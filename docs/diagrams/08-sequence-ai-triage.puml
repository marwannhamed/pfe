@startuml 08-sequence-ai-triage
!include _theme.puml

title Sequence diagram — assisted triage of a maintenance ticket

autonumber "<b>[00]"

actor "Reporter" as U
participant "Form" as UI
box "LeaseManager" #FAFCFC
  participant "AiController" as CTRL
  participant "MaintenanceTriage\nService" as T
  participant "OpenAiService" as OAI
end box
participant "Groq" as LLM
database "PostgreSQL" as DB

U -> UI : types the fault, leaves the field
UI -> CTRL : POST /ai/maintenance/triage
activate CTRL
CTRL -> T : triage(user, { title, description })
activate T

== 1. Classification ==
T -> OAI : chatJson(text, permitted enumerations)
activate OAI
OAI -> LLM : chat/completions
LLM --> OAI : { category, priority, reason }
deactivate OAI

alt values inside our enumerations
  T -> T : source = "model"
else invented value, missing key\nor provider unreachable
  T -> T : keyword classifier\nsource = "keywords"
  note right of T #F7EEDA
    Raising a ticket never depends on a
    third party being available.
  end note
end

== 2. Suggested technician ==
alt caller may assign\n(SUPER_ADMIN, CLIENT_ADMIN, MANAGER)
  T -> DB : technicians in this company
  T -> DB : resolved in this category,\ntickets currently open
  T -> T : score = experience * 10 - workload * 6
  T -> DB : past fixes\nin these buildings
  note right of T
    The technician comes from SQL, not the model.
    A model asked to name a person invents people
    who do not work here, and a manager has to be
    able to defend the choice.
  end note
else caller is a renter
  T -> T : suggestedAssignee = null\nsimilar = []
  note right of T
    Otherwise the renter would learn who works
    for their landlord, and what else is broken
    elsewhere in the building.
  end note
end

T --> CTRL : { category, priority, reason,\n  suggestedAssignee, similar, source }
deactivate T
CTRL --> UI : 201 Created
deactivate CTRL

UI -> U : shows the suggestion
alt the reporter accepts
  U -> UI : "Apply"
  UI -> UI : fills in category and priority
else
  U -> UI : enters their own values
end

note over U, UI
  A suggestion, never applied silently:
  the reporter remains the author of their ticket.
end note

@enduml
