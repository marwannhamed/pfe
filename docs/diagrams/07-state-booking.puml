@startuml 07-state-booking
!include _theme.puml

title State diagram — the life of a booking

[*] --> DRAFT

DRAFT : Draft created
DRAFT --> PENDING_APPROVAL : submit

state "Review by the property company" as INSTR {
  PENDING_APPROVAL : Awaiting decision
  PENDING_APPROVAL --> PENDING_PHONE_CONFIRMATION : accept\n[manager]
  PENDING_APPROVAL --> REFUSED : reject\n[manager]

  PENDING_PHONE_CONFIRMATION : Confirmation call
  PENDING_PHONE_CONFIRMATION --> AWAITING_PHYSICAL_VISIT : reached\n[receptionist]
  PENDING_PHONE_CONFIRMATION --> NO_SHOW : unreachable\n[receptionist]

  AWAITING_PHYSICAL_VISIT : Site visit
  AWAITING_PHYSICAL_VISIT --> DOCUMENTS_PENDING_UPLOAD : visit done\n[receptionist]

  DOCUMENTS_PENDING_UPLOAD : Supporting documents
  DOCUMENTS_PENDING_UPLOAD --> CONFIRMED : file complete\n[manager]
}

CONFIRMED : Firm booking
CONFIRMED --> CHECKED_IN : moved in
CONFIRMED --> CANCELLED : cancel

CHECKED_IN : Occupancy under way
CHECKED_IN --> COMPLETED : term ended

PENDING_APPROVAL --> CANCELLED : withdraw

COMPLETED --> [*]
CANCELLED --> [*]
REFUSED --> [*]
NO_SHOW --> [*]

note right of INSTR
  This phase is specific to the target
  market: commercial leasing in Qatar is
  concluded in person. The call and then
  the visit precede any signature.
end note

legend bottom
  Twelve states. The role entitled to trigger each transition is shown in brackets.
endlegend

@enduml
