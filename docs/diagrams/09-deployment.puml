@startuml 09-deployment
!include _theme.puml

title Deployment diagram — docker compose up

skinparam linetype ortho

node "Client machine" as CLIENT {
  artifact "Browser" as BROWSER
}

node "Docker host" as HOST {

  node "leasemanager-web\n<<container>>" as WEB {
    component "nginx 1.27-alpine" as NGINX
    artifact "React SPA\n(Vite build)" as SPA
  }

  node "leasemanager-api\n<<container>>" as APINODE {
    component "NestJS 11\nNode 20" as NEST
    component "Prisma Client" as PRISMA
    component "Socket.IO\n/notifications" as WSGW
  }

  node "leasemanager-postgres\n<<container>>" as PGNODE {
    database "PostgreSQL 13.5" as PG
  }

  node "leasemanager-adminer\n<<container>>" as ADMNODE {
    component "Adminer" as ADM
  }

  storage "postgres_data\n<<volume>>" as VOL
}

cloud "External services" as EXT {
  component "Groq  (LLM)" as GROQ
  component "Brevo  (email)" as BREVO
  component "Cloudinary  (files)" as CLOUD
  component "Typeform  (webhook)" as TYPE
}

BROWSER --> NGINX : HTTPS\n:5173
BROWSER --> ADM : :8081
NGINX --> SPA : serves
NGINX --> NEST : proxies /auth /bookings /spaces …\nsame origin
NGINX --> WSGW : upgrades /socket.io
NEST --> PRISMA
PRISMA --> PG : :5432
ADM --> PG
PG --> VOL : persists

NEST ..> GROQ : HTTPS
NEST ..> BREVO : HTTPS
NEST ..> CLOUD : HTTPS
TYPE ..> NEST : signed webhook

note bottom of HOST
  Each service waits for the one below it to report <i>healthy</i>:
  postgres (pg_isready), then api (/health), then web.
  The database is seeded only when empty, so a restart
  never overwrites existing data.
end note

legend bottom
  Four containers from a single command. nginx serves the application and
  proxies the API on the same origin: no cross-origin request, therefore no
  CORS configuration, and no hostname compiled into the bundle.
endlegend

@enduml
