title Enumerations (2/2) — leases and billing, operations and supervision

package "Leases and billing" {
  enum ContractStatus <<enumeration>> {
    DRAFT
    ACTIVE
    EXPIRED
    TERMINATED
    RENEWED
  }
  enum InvoiceType <<enumeration>> {
    MONTHLY_RENT
    ONE_TIME_CHARGE
    DEPOSIT
    PENALTY
    CREDIT
  }
  enum InvoiceStatus <<enumeration>> {
    DRAFT
    ISSUED
    SENT
    PARTIALLY_PAID
    PAID
    OVERDUE
    CANCELLED
  }
  enum DiscountType <<enumeration>> {
    PERCENTAGE
    FIXED_AMOUNT
  }
  enum PaymentMethod <<enumeration>> {
    CASH
    BANK_TRANSFER
    CREDIT_CARD
    DEBIT_CARD
    CHECK
    ONLINE_PAYMENT
  }
  enum PaymentStatus <<enumeration>> {
    PENDING
    COMPLETED
    FAILED
    REFUNDED
  }
}
package "Operations and supervision" {
  enum TicketCategory <<enumeration>> {
    PLUMBING
    ELECTRICAL
    HVAC
    CLEANING
    FURNITURE
    IT_EQUIPMENT
    OTHER
  }
  enum TicketPriority <<enumeration>> {
    LOW
    NORMAL
    HIGH
    URGENT
    EMERGENCY
  }
  enum TicketStatus <<enumeration>> {
    OPEN
    ASSIGNED
    IN_PROGRESS
    RESOLVED
    CLOSED
    CANCELLED
  }
  enum NotificationType <<enumeration>> {
    BOOKING_CONFIRMATION
    BOOKING_REMINDER
    MARKETPLACE_INQUIRY
    INVOICE_ISSUED
    INVOICE_OVERDUE
    PAYMENT_RECEIVED
    TICKET_UPDATED
    CONTRACT_EXPIRING
    LOGIN_SUCCESS
    SECURITY_ALERT
    TENANT_APPLICATION
  }
  enum NotificationChannel <<enumeration>> {
    IN_APP
    EMAIL
    SMS
  }
  enum NotificationPriority <<enumeration>> {
    LOW
    NORMAL
    HIGH
    URGENT
  }
  enum AuditAction <<enumeration>> {
    CREATE
    UPDATE
    DELETE
    LOGIN
    LOGOUT
    LOGIN_FAILED
    APPROVE
    REJECT
  }
  enum AuditSeverity <<enumeration>> {
    INFO
    WARNING
    ERROR
    CRITICAL
  }
  enum ReportType <<enumeration>> {
    OCCUPANCY_RATE
    REVENUE_BY_SITE
    BOOKING_ANALYTICS
    PAYMENT_STATUS
    MAINTENANCE_SUMMARY
    FINANCIAL_SUMMARY
  }
  enum ReportFormat <<enumeration>> {
    PDF
    CSV
    EXCEL
    JSON
  }
}

