@startuml 04-sequence-authorisation
!include _theme.puml

title Sequence diagram — authorising one request

autonumber "<b>[00]"

actor "Manager\n(Msheireb)" as MGR
participant "nginx" as NGX
box "NestJS API" #FAFCFC
  participant "JwtAuthGuard" as JWT
  participant "RolesGuard" as ROLES
  participant "ValidationPipe" as VALID
  participant "MaintenanceController" as CTRL
  participant "MaintenanceService" as SVC
end box
database "PostgreSQL" as DB

MGR -> NGX : GET /maintenance\nAuthorization: Bearer <token>
activate NGX
NGX -> JWT : same-origin proxy
activate JWT

JWT -> JWT : verify signature,\ndecode claims
alt token invalid or expired
  JWT --> MGR : 401 Unauthorized
else token valid
  JWT -> ROLES : request.user = {id, role, tenant_id}
  deactivate JWT
  activate ROLES

  ROLES -> ROLES : read @Roles(...) on the route
  note right of ROLES #F7EEDA
    A route declaring no @Roles is open to
    any authenticated user. That permissive
    default is what left an entire module
    reachable by every account.
  end note

  alt role not permitted
    ROLES --> MGR : 403 Forbidden
  else role permitted
    ROLES -> VALID : request admitted
    deactivate ROLES
    activate VALID
    VALID -> VALID : whitelist + forbidNonWhitelisted
    note right of VALID
      Unknown fields are rejected, not
      ignored: a client cannot smuggle in
      a role or a tenant_id.
    end note
    VALID -> CTRL : validated DTO
    deactivate VALID
    activate CTRL

    CTRL -> SVC : findAllForUser(user, filters)
    note right of CTRL
      The controller never calls
      the unscoped method.
    end note
    activate SVC

    SVC -> SVC : landlordTicketScope(user)
    SVC -> DB : WHERE space.floor.building.tenant_id\n      = user.tenant_id
    activate DB
    DB --> SVC : 18 rows (of 54 in total)
    deactivate DB
    SVC --> CTRL : the caller's own tickets
    deactivate SVC
    CTRL --> MGR : 200 OK
    deactivate CTRL
  end
end
deactivate NGX

legend bottom
  Five stages traversed by every authenticated call. Understanding this chain
  is enough to understand the security of the whole back end.
endlegend

@enduml
