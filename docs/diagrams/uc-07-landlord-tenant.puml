' Source: tenant_use_case_vertical_diagrams.zip — same actors, use cases and links;
' layout and style follow the LeaseManager diagrams.
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 12
skinparam ranksep 110
skinparam linetype polyline

title Use Case Diagram — Landlord Tenant (CLIENT / Level 2)

actor "Tenant User" as TU
actor "Landlord Tenant" as LT
actor "Property Manager" as PM
actor "Receptionist" as REC
actor "Finance Staff" as FIN
actor "Maintenance Staff" as MAIN

rectangle "LeaseManager — Landlord Workspace" {
  package "Property & Availability" {
    usecase "Manage buildings and floors" as UC1
    usecase "Manage spaces and features" as UC2
    usecase "Set space rates and availability" as UC3
    usecase "Publish / list spaces" as UC4
    usecase "Manage add-on services" as UC5
    usecase "Manage promotion codes" as UC6
  }
  package "Applications & Bookings" {
    usecase "Review tenant applications" as UC7
    usecase "Review booking applications" as UC8
    usecase "Approve or refuse applications" as UC9
    usecase "Manage bookings" as UC10
    usecase "Manage booking documents" as UC11
  }
  package "Tenants, Leases & Finance" {
    usecase "Manage tenant organisations" as UC12
    usecase "Manage staff accounts" as UC13
    usecase "Manage lease contracts" as UC14
    usecase "Manage invoices" as UC15
    usecase "Record and track payments" as UC16
  }
  package "Operations & Reporting" {
    usecase "Manage maintenance tickets" as UC17
    usecase "Assign maintenance work" as UC18
    usecase "Consult reports and analytics" as UC19
    usecase "Consult audit logs" as UC20
    usecase "Manage notifications" as UC21
  }
}

' generalisations: the hollow triangle points to the parent actor
TU <|-- LT
LT <|-- PM
LT <|-- REC
LT <|-- FIN
LT <|-- MAIN

' actor order, top to bottom
PM -[hidden]> REC
REC -[hidden]> FIN
FIN -[hidden]> MAIN

PM -- UC1
PM -- UC2
PM -- UC3
PM -- UC4
PM -- UC5
PM -- UC6
PM -- UC7
PM -- UC8
PM -- UC9
PM -- UC10
PM -- UC12
PM -- UC13
PM -- UC14
PM -- UC17
PM -- UC19
PM -- UC20
REC -- UC7
REC -- UC8
REC -- UC9
REC -- UC10
REC -- UC11
FIN -- UC14
FIN -- UC15
FIN -- UC16
FIN -- UC19
MAIN -- UC17
MAIN -- UC18

legend bottom left
Tenant User is the parent actor.
Landlord Tenant and its staff roles specialize the actor on their left.
endlegend
