@startuml 01-use-case-global
!include _theme.puml

title Use case diagram — LeaseManager

left to right direction

' PlantUML places actors declared before the system on the left, and those
' declared after on the right. Splitting the cast across both sides avoids a
' single column of nine actors with edges dragged across the whole figure.

' ── Actors outside the owning organisation ───────────────────────────────────
actor "Visitor" as GUEST
actor "Employee" as EMP
actor "Tenant admin" as TAD

rectangle "LeaseManager" {
  usecase "Search for a space" as UC1
  usecase "Submit an application" as UC2
  usecase "Book a space" as UC3
  usecase "Process a booking" as UC4
  usecase "Manage the portfolio" as UC5
  usecase "Manage leases" as UC6
  usecase "Invoice and collect" as UC7
  usecase "Handle maintenance" as UC8
  usecase "Review analytics" as UC9
  usecase "Administer the platform" as UC10
}

' ── Property company and platform actors ─────────────────────────────────────
actor "Receptionist" as REC
actor "Technician" as TEC
actor "Manager" as MGR
actor "Finance" as FIN
actor "Client admin" as CAD
actor "Platform\nowner" as SAD

' Generalisation: a tenant admin does everything an employee does.
EMP <|-- TAD
MGR <|-- CAD

' ── Associations, left-hand actors ───────────────────────────────────────────
GUEST --> UC1
GUEST --> UC2
EMP   --> UC3
EMP   --> UC8
TAD   --> UC6
TAD   --> UC7

' ── Associations, right-hand actors ──────────────────────────────────────────
UC4  <-- REC
UC8  <-- TEC
UC4  <-- MGR
UC5  <-- MGR
UC6  <-- MGR
UC9  <-- MGR
UC7  <-- FIN
UC9  <-- FIN
UC10 <-- SAD
UC9  <-- SAD

legend bottom
  Overview. The cases are detailed in diagrams 01a to 01c.
  Level 2 and level 3 actors see only their own organisation's data;
  the platform owner alone reads across every organisation.
endlegend

@enduml
