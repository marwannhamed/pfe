hide footbox
autonumber "<b>0"
skinparam ParticipantPadding 4
skinparam BoxPadding 4
skinparam maxMessageSize 220
skinparam responseMessageBelowArrow true

title Sequence diagram — booking application (2/4): the manager accepts it

actor "Property Manager" as M
box "Front end · React" #F3F7FC
boundary "BookingApplications\nPage" as UI
end box
box "Back end · NestJS" #F3F8F4
control "BookingApplication\nController" as C
participant "BookingApplication\nService" as S <<service>>
participant "BillingService" as B <<service>>
participant "Notification\nService" as NS <<service>>
participant "MailService" as MS <<service>>
participant "PrismaService" as PR <<repository>>
end box
box "Data" #F7F4FB
database "**PostgreSQL**" as DB
end box

M -> UI : Accept
UI -> C ++ : PATCH /booking-applications/:id/accept
C -> S ++ : accept(user, id)
S -> PR : bookingApplication.findUnique()
PR -> DB : SELECT booking_applications
break not a manager (403), or status is not PENDING (400)
  S --> C : exception
  C --> UI : 403 / 400
end
S -> S : pickReceptionist()
group prisma.$transaction
  S -> PR : booking.create(PENDING_PHONE_CONFIRMATION)
  S -> PR : bookingAddOn.create() for each add-on
  S -> PR : space.update({ status: RESERVED })
  S -> PR : bookingApplication.update(ACCEPTED)
  PR -> DB : INSERT, UPDATE, COMMIT
end
S ->> MS : sendApplicationAcceptedPendingCall()
S -> NS : create(BOOKING_REMINDER)
S -> B ++ : generateInvoiceFromBooking(id)
B -> PR : invoice.create(MONTHLY_RENT, ISSUED)
PR -> DB : INSERT invoices, lines
B ->> MS : sendEmail(invoice)
return invoice
S -> PR : booking.update({ invoice_id })
PR -> DB : UPDATE bookings
S --> C : application + booking
deactivate S
C --> UI : 200 OK
deactivate C
@enduml
