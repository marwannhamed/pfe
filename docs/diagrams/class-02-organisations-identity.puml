title Class diagram — package Organisations and identity

package "Organisations and identity" {
  class Tenant <<entity>> {
    id : String {id}
    name : String
    slug : String {unique}
    contact_email : String
    status : TenantStatus
    subscription_plan : String
    max_users : Int
    max_spaces : Int
    organization_type : OrganizationType
    reporting_embeds : Json [0..1]
    brevo_contact_id : String [0..1]
    application_profile : Json [0..1]
    application_documents : Json [0..1]
    created_at : DateTime
  }
  class User <<entity>> {
    id : String {id}
    role : UserRole
    email : String {unique}
    password : String
    first_name : String [0..1]
    last_name : String [0..1]
    phone_number : String [0..1]
    status : UserStatus
    must_change_password : Boolean
    refreshToken : String [0..1]
    session_refresh_token : String [0..1]
    avatar_url : String [0..1]
    last_login_at : DateTime [0..1]
    crisp_session_id : String [0..1]
    notification_preferences : Json [0..1]
    created_at : DateTime
    updated_at : DateTime {updatedAt}
  }
  class UserSession <<entity>> {
    id : String {id}
    refresh_token : String {unique}
    created_at : DateTime
    last_used_at : DateTime
  }
  class TenantApplication <<entity>> {
    id : String {id}
    status : TenantApplicationStatus
    typeform_response_id : String [0..1] {unique}
    contact_email : String [0..1]
    company_name : String [0..1]
    raw_payload : Json [0..1]
    created_at : DateTime
    updated_at : DateTime {updatedAt}
  }
  class TenantOnboardingSequence <<entity>> {
    id : String {id}
    baseline_at : DateTime
    day0_sent_at : DateTime [0..1]
    day1_sent_at : DateTime [0..1]
    day3_sent_at : DateTime [0..1]
    day7_sent_at : DateTime [0..1]
    day30_sent_at : DateTime [0..1]
    created_at : DateTime
    updated_at : DateTime {updatedAt}
  }
}
class Space <<entity>> #F6F8FB;line:8FA7C2;line.dashed

Tenant "1" *-- "0..*" User : employs >
Tenant "tenantCompany\n0..1" -- "tenantCompanyUsers\n0..*" User
User "managedBy\n0..1" -- "receptionStaff\n0..*" User
User "1" *-- "0..*" UserSession : opens >
Tenant "1" *-right- "0..1" TenantOnboardingSequence : follows >
Tenant "landlord_tenant\n1" *-- "0..*" TenantApplication : receives >
Tenant "applicant_tenant\n0..1" -- "0..1" TenantApplication : < creates
TenantApplication "0..*" -- "0..1" Space : targets >

legend bottom right
Classes shown by name only belong to other packages
and are detailed in their own diagram.
endlegend
